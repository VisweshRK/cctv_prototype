# Copy this file to .env and fill in real values. .env is git-ignored: never commit it.
#
# Full stream address of each camera. Typical RTSP form:
#   rtsp://USER:PASSWORD@CAMERA_IP:554/PATH
# The exact PATH depends on the Q-Tech model (check its app/manual, or try ONVIF
# discovery in the go2rtc web UI: Add -> ONVIF).

CAM1_URL=rtsp://admin:CHANGE_ME@192.168.1.101:554/stream1
CAM2_URL=rtsp://admin:CHANGE_ME@192.168.1.102:554/stream1

# No camera yet? Use a video file as a fake camera (see docs/TEAM_GUIDE.md):
# CAM1_URL=ffmpeg:samples/test.mp4#input=loop#video=copy#audio=copy
# CAM2_URL=ffmpeg:samples/test.mp4#input=loop#video=copy#audio=copy

# Dual-lens camera (two lenses in one picture, one above the other, e.g. 1920x2160)?
# Give the camera to DUAL_URL and cut cam1 / cam2 out of it: each lens becomes its own
# camera on the dashboard and for the AI worker. The siren still uses the camera's speaker.
# -force_key_frames: a keyframe every second, so the AI worker's snapshots don't wait up to 5 s.
# DUAL_URL=rtsp://admin:CHANGE_ME@192.168.1.101:554/stream1
# CAM1_URL=ffmpeg:dual#video=h264#raw=-vf crop=iw:ih/2:0:0 -force_key_frames expr:gte(t,n_forced)
# CAM2_URL=ffmpeg:dual#video=h264#raw=-vf crop=iw:ih/2:0:ih/2 -force_key_frames expr:gte(t,n_forced)
