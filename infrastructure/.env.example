# Presence B2C Platform Environment Configuration
PROJECT_NAME="Presence B2C CCTV AI Platform"
VERSION="1.0.0"
API_PREFIX="/api"

# Security
SECRET_KEY="presence-b2c-production-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL for production Docker, or SQLite for local development)
DATABASE_URL="postgresql+asyncpg://presence:presence_pass@localhost:5432/presence_b2c"
# DATABASE_URL="sqlite+aiosqlite:///e:/cctv/presence_b2c.db"

# Streaming & go2rtc WebRTC Gateway
GO2RTC_API_URL="http://localhost:1984"
STREAMING_PORT=8000
SNAPSHOT_DIR="e:/cctv/storage/snapshots"

# Edge AI Optimization
USE_INT8_DETECTOR="1"
